<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng ký - FoodEats</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<style>
  .custom-icon {
  width: 20px;      
  height: 20px;   
  object-fit: contain; 
  vertical-align: middle; 
  margin-right: 5px; 
}

.custom-icon-lg {
  width: 24px;
  height: 24px;
  vertical-align: middle;
  margin-right: 8px;
}
</style>
<body>

  <div class="fixed-video-background">
    <video src="/videos/Animation Foodeats1.mp4" autoplay muted loop playsinline></video>
  </div>

  <a href="/" class="btn-back-home">
    ❮ Trang chủ
  </a>

  <div id="toast" class="toast"></div>

  <div class="auth-wrapper">
    <div class="auth-box">
      <div class="auth-header">
        <a href="/" class="auth-logo">Food<span>Eats</span></a>
        <h2 class="auth-title">Đăng ký tài khoản</h2>
        <p class="auth-subtitle" id="auth-subtitle">Trở thành thành viên FoodEats để nhận ngàn ưu đãi hấp dẫn!</p>
      </div>

      <div class="role-tabs">
        <button type="button" class="tab-btn active" id="btn-buyer" onclick="switchRole('buyer')">Người mua</button>
        <button type="button" class="tab-btn" id="btn-seller" onclick="switchRole('seller')">Cửa hàng</button>
      </div>

      <form id="registerForm" action="/register" method="POST" enctype="multipart/form-data" onsubmit="handleRegister(event)">
        <input type="hidden" name="role" id="roleInput" value="buyer">

        <div class="form-group">
          <label>Họ và tên</label>
          <input type="text" name="fullName" placeholder="Nhập họ và tên" required>
        </div>

        <div class="form-group">
          <label>Ngày tháng năm sinh</label>
          <input type="date" name="dob" required>
        </div>

        <div class="form-group">
          <label>Số điện thoại</label>
          <div class="input-group">
            <input type="tel" name="phone" pattern="^(0|\+84)[3|5|7|8|9][0-9]{8}$" title="Nhập đúng định dạng số điện thoại VN" placeholder="Ví dụ: 0912345678" required>
            <button type="button" class="btn-otp" onclick="sendOTP()">Gửi OTP</button>
          </div>
        </div>

        <div class="form-group">
          <label>Mã OTP</label>
          <input type="text" name="otp" placeholder="Nhập 6 số OTP" maxlength="6">
        </div>

        <div class="role-content active" id="content-buyer">
          <div class="form-group">
            <label>Tên tài khoản</label>
            <input type="text" id="reg-username" name="username" placeholder="Nhập tên tài khoản">
          </div>
        </div>

        <div class="role-content" id="content-seller">
          <div class="form-group">
            <label>Tên quán</label>
            <input type="text" id="reg-storeName" name="storeName" placeholder="Ví dụ: Phở Bát Đàn" disabled>
          </div>
          
          <div class="form-group">
            <label>Địa chỉ cửa hàng</label>
            <input type="text" id="reg-address" name="address" placeholder="Số nhà, Tên đường, Phường, Quận, Thành phố..." disabled>
          </div>

          <div class="form-group">
            <label>Giấy phép kinh doanh (Tùy chọn)</label>
            <input type="file" id="reg-license" name="businessLicense" accept="image/*, .pdf" disabled>
          </div>

          <div class="form-group">
            <label>Mã số thuế / CCCD</label>
            <input type="text" id="reg-tax" name="taxId" placeholder="Mã số thuế hoặc CCCD chủ quán" disabled>
          </div>
        </div>

        <div class="form-group">
          <label>Mật khẩu</label>
          <div class="password-wrapper">
            <input type="password" id="regPassword" name="password" placeholder="Tạo mật khẩu (tối thiểu 6 ký tự)" required oninput="checkPasswordStrength(this.value)">
            <button type="button" class="eye-btn" onclick="togglePassword('regPassword', this)"><img src="/images/iconsImages/view.png" alt="view" class="custom-icon-lg"></button>
          </div>
          <div class="password-strength" id="password-strength-container" style="display: none;">
            <div class="strength-bar-bg">
              <div class="strength-bar" id="strength-bar"></div>
            </div>
            <span class="strength-text" id="strength-text"></span>
          </div>
          <small class="form-hint">Mẹo: Nên kết hợp chữ hoa, thường, số và ký tự đặc biệt.</small>
        </div>

        <div class="form-group">
          <label>Nhập lại mật khẩu</label>
          <div class="password-wrapper">
            <input type="password" id="confirmPassword" placeholder="Nhập lại mật khẩu" required>
            <button type="button" class="eye-btn" onclick="togglePassword('confirmPassword', this)"><img src="/images/iconsImages/view.png" alt="view" class="custom-icon-lg"></button>
          </div>
        </div>

        <div class="action-buttons">
          <button type="submit" class="btn-submit">Đăng ký ngay</button>

          <div class="social-auth-divider">
            <span>Hoặc tiếp tục với</span>
          </div>

          <div class="social-buttons">
            <button type="button" class="btn-social" onclick="showToast('Đăng ký bằng Google đang được xử lý...', 'success')">
              <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
                <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12 0 14.5s.7 4.8 1.9 7.2l3.7-2.9z"/>
                <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 17C3.7 20.7 7.5 24 12 24z"/>
              </svg>
              <span>Google</span>
            </button>
            <button type="button" class="btn-social" onclick="showToast('Đăng ký bằng Facebook đang được xử lý...', 'success')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </button>
          </div>

          <a href="/login" class="btn-secondary">Đã có tài khoản? Đăng nhập</a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>