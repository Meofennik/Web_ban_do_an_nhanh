<%- include('../partials/header') %>

    <style>
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type=number] {
            -moz-appearance: textfield;
        }

        .custom-icon {
            width: 20px;
            height: 20px;
            object-fit: contain;
            vertical-align: middle;
            margin-right: 5px;
        }

        .custom-icon-lg {
            width: 24px;
            height: 24px;
            vertical-align: middle;
            margin-right: 8px;
        }

        .cart-page-wrapper {
            max-width: 1000px;
            margin: 30px auto 60px;
            padding: 0 15px;
            font-family: 'Segoe UI', Roboto, sans-serif;
        }

        /* Order Steps */
        .order-steps {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
            gap: 15px;
        }
        .step-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #999;
        }
        .step-item.active {
            color: #ee4d2d;
        }
        .step-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #eee;
            color: #777;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }
        .step-item.active .step-circle {
            background: #ee4d2d;
            color: #fff;
        }
        .step-line {
            width: 40px;
            height: 2px;
            background: #eee;
        }

        .cart-card {
            background: #fff;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }

        .cart-title {
            margin: 0 0 20px;
            font-size: 24px;
            color: #222;
            display: flex;
            align-items: center;
        }

        .qty-btn {
            width: 32px;
            height: 32px;
            border: 1px solid #ddd;
            background: #f8f9fa;
            cursor: pointer;
            font-weight: bold;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }
        .qty-btn:hover {
            background: #e9ecef;
        }

        .qty-input {
            width: 45px;
            height: 32px;
            text-align: center;
            border: 1px solid #ddd;
            border-radius: 6px;
            margin: 0 5px;
            font-weight: 600;
        }

        .btn-delete {
            background: #fff1f0;
            color: #ff4d4f;
            border: 1px solid #ffccc7;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.2s;
        }
        .btn-delete:hover {
            background: #ff4d4f;
            color: #fff;
        }

        /* Empty state */
        .empty-cart-container {
            text-align: center;
            padding: 60px 20px;
        }
        .empty-cart-icon {
            font-size: 70px;
            margin-bottom: 15px;
        }
        .empty-cart-title {
            font-size: 20px;
            font-weight: 700;
            color: #333;
            margin: 0 0 10px;
        }
        .empty-cart-desc {
            color: #777;
            font-size: 14.5px;
            max-width: 400px;
            margin: 0 auto 25px;
            line-height: 1.5;
        }
        .btn-browse-menu {
            display: inline-block;
            background: linear-gradient(135deg, #ff7e5f, #ee4d2d);
            color: #fff;
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 700;
            font-size: 15px;
            text-decoration: none;
            box-shadow: 0 6px 15px rgba(238, 77, 45, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-browse-menu:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(238, 77, 45, 0.4);
        }
    </style>

    <div class="cart-page-wrapper">
        <!-- Progress Steps -->
        <div class="order-steps">
            <div class="step-item active">
                <span class="step-circle">1</span>
                <span>Giỏ hàng</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item">
                <span class="step-circle">2</span>
                <span>Thanh toán</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item">
                <span class="step-circle">3</span>
                <span>Hoàn tất</span>
            </div>
        </div>

        <div class="cart-card">
            <h2 class="cart-title">
                <img src="/images/iconsImages/shopping-cart.png" alt="shopping-cart" class="custom-icon-lg"> Giỏ Hàng Của Bạn
            </h2>

            <% if (cart && cart.items && cart.items.length > 0) { %>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                        <thead>
                            <tr style="background: #fafafa; border-bottom: 2px solid #eee; text-align: left; color: #555; font-size: 14px;">
                                <th style="padding: 14px 12px;">Món ăn</th>
                                <th style="padding: 14px 12px;">Đơn giá</th>
                                <th style="padding: 14px 12px;">Số lượng</th>
                                <th style="padding: 14px 12px;">Thành tiền</th>
                                <th style="padding: 14px 12px; text-align: center;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let grandTotal = 0; %>
                            <% cart.items.forEach(item => { %>
                                <% if (item.productId) { %>
                                    <% const itemTotal = item.productId.price * item.quantity; %>
                                    <% grandTotal += itemTotal; %>
                                    <tr style="border-bottom: 1px solid #f0f0f0;">
                                        <td style="padding: 14px 12px; display: flex; align-items: center; gap: 14px;">
                                            <img src="<%= item.productId.imageUrl %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; border: 1px solid #eee;">
                                            <div style="flex: 1;">
                                                <strong style="display: block; font-size: 15px; color: #222; margin-bottom: 6px;">
                                                    <%= item.productId.name %>
                                                </strong>
                                                <input type="text" class="note-input"
                                                    data-id="<%= item.productId._id %>"
                                                    value="<%= item.note || '' %>"
                                                    placeholder="Ghi chú bếp (VD: Không cay, ít đá...)"
                                                    style="width: 100%; max-width: 280px; padding: 6px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 12.5px; box-sizing: border-box; outline: none; background: #fafafa;">
                                            </div>
                                        </td>
                                        <td style="padding: 14px 12px; font-size: 15px; color: #444;">
                                            <%= (Number(item.productId.price) || 0).toLocaleString('vi-VN') %>đ
                                        </td>

                                        <td style="padding: 14px 12px;">
                                            <div style="display: flex; align-items: center;">
                                                <button type="button" class="qty-btn btn-minus" data-id="<%= item.productId._id %>">-</button>
                                                <input type="number" class="qty-input"
                                                    id="qty-<%= item.productId._id %>"
                                                    data-id="<%= item.productId._id %>"
                                                    data-price="<%= item.productId.price %>"
                                                    value="<%= item.quantity %>" min="1" max="999">
                                                <button type="button" class="qty-btn btn-plus" data-id="<%= item.productId._id %>">+</button>
                                            </div>
                                        </td>

                                        <td style="padding: 14px 12px; color: #ee4d2d; font-weight: 700; font-size: 15px;" id="item-total-<%= item.productId._id %>">
                                            <%= itemTotal.toLocaleString('vi-VN') %>đ
                                        </td>

                                        <td style="padding: 14px 12px; text-align: center;">
                                            <button type="button" class="btn-delete" data-id="<%= item.productId._id %>" style="margin: 0 auto;">
                                                <img src="/images/iconsImages/bin.png" alt="bin" class="custom-icon"> Xóa
                                            </button>
                                        </td>
                                    </tr>
                                <% } %>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 30px; border-top: 2px solid #f0f0f0; padding-top: 25px; flex-wrap: wrap; gap: 20px;">
                    <a href="/" style="color: #ee4d2d; text-decoration: none; font-weight: 700; font-size: 15px; display: inline-flex; align-items: center; gap: 6px;">
                        ← Tiếp tục khám phá món ngon
                    </a>
                    <div style="text-align: right;">
                        <div style="margin-bottom: 12px; font-size: 16px; color: #444;">
                            Tổng thanh toán:
                            <span id="grand-total" style="color: #ee4d2d; font-size: 26px; font-weight: 800; margin-left: 8px;">
                                <%= grandTotal.toLocaleString('vi-VN') %>đ
                            </span>
                        </div>
                        <a href="/order/checkout" style="background: linear-gradient(135deg, #ff7e5f, #ee4d2d); color: white; border: none; padding: 14px 36px; font-size: 16px; font-weight: 700; border-radius: 8px; cursor: pointer; transition: 0.2s; text-decoration: none; display: inline-block; box-shadow: 0 6px 15px rgba(238, 77, 45, 0.3);">
                            Tiến Hành Đặt Hàng →
                        </a>
                    </div>
                </div>
            <% } else { %>
                <div class="empty-cart-container">
                    <div class="empty-cart-icon">🛒</div>
                    <h3 class="empty-cart-title">Giỏ hàng của bạn đang trống</h3>
                    <p class="empty-cart-desc">Có vẻ như bạn chưa chọn món ăn nào. Hãy khám phá thực đơn đa dạng và tận hưởng ưu đãi hôm nay!</p>
                    <a href="/" class="btn-browse-menu">Khám phá món ngon ngay</a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function updateGrandTotal() {
            let totalMoney = 0;
            let totalItems = 0;

            document.querySelectorAll('.qty-input').forEach(input => {
                const qty = parseInt(input.value) || 1;
                const price = parseInt(input.getAttribute('data-price')) || 0;

                totalMoney += (qty * price);
                totalItems += qty;
            });

            const grandTotalEl = document.getElementById('grand-total');
            if (grandTotalEl) {
                grandTotalEl.innerText = totalMoney.toLocaleString('vi-VN') + 'đ';
            }

            const cartBadge = document.getElementById('cart-badge');
            if (cartBadge) {
                cartBadge.innerText = totalItems;
                cartBadge.style.display = totalItems > 0 ? 'inline-block' : 'none';
            }
        }

        async function removeCartItem(productId, btnElement) {
            const row = btnElement.closest('tr');
            row.style.opacity = '0.4';

            try {
                const res = await fetch('/cart/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId })
                });
                const data = await res.json();

                if (data.success) {
                    row.remove();
                    updateGrandTotal();
                } else {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Lỗi xóa sản phẩm', 'error');
                    } else {
                        alert(data.message || 'Lỗi xóa sản phẩm');
                    }
                    row.style.opacity = '1';
                }
            } catch (err) {
                console.error('Lỗi xóa sản phẩm:', err);
                row.style.opacity = '1';
            }
        }

        async function updateCartQuantity(productId, newQuantity, price) {
            try {
                const response = await fetch('/cart/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId, quantity: newQuantity })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    const inputEl = document.getElementById(`qty-${productId}`);
                    if (inputEl) {
                        inputEl.value = newQuantity;
                    }

                    const itemTotalEl = document.getElementById(`item-total-${productId}`);
                    if (itemTotalEl) {
                        const newTotal = newQuantity * price;
                        itemTotalEl.innerText = newTotal.toLocaleString('vi-VN') + 'đ';
                    }

                    updateGrandTotal();
                } else {
                    if (typeof showToast === 'function') {
                        showToast(result.message || 'Lỗi cập nhật số lượng', 'error');
                    } else {
                        alert(result.message || 'Lỗi cập nhật số lượng');
                    }
                }
            } catch (error) {
                console.error('Lỗi khi gọi API update cart:', error);
            }
        }

        document.addEventListener('click', function (e) {
            const minusBtn = e.target.closest('.btn-minus');
            if (minusBtn) {
                e.preventDefault();
                const id = minusBtn.getAttribute('data-id');
                const input = document.getElementById(`qty-${id}`);
                if (input) {
                    let currentVal = parseInt(input.value) || 1;
                    let price = parseInt(input.getAttribute('data-price')) || 0;
                    if (currentVal > 1) updateCartQuantity(id, currentVal - 1, price);
                }
            }

            const plusBtn = e.target.closest('.btn-plus');
            if (plusBtn) {
                e.preventDefault();
                const id = plusBtn.getAttribute('data-id');
                const input = document.getElementById(`qty-${id}`);
                if (input) {
                    let currentVal = parseInt(input.value) || 1;
                    let price = parseInt(input.getAttribute('data-price')) || 0;
                    if (currentVal < 999) updateCartQuantity(id, currentVal + 1, price);
                }
            }

            const deleteBtn = e.target.closest('.btn-delete');
            if (deleteBtn) {
                e.preventDefault();
                const id = deleteBtn.getAttribute('data-id');
                if (id) removeCartItem(id, deleteBtn);
            }
        });

        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('qty-input')) {
                const id = e.target.getAttribute('data-id');
                let val = parseInt(e.target.value);
                let price = parseInt(e.target.getAttribute('data-price')) || 0;

                if (isNaN(val) || val < 1) val = 1;
                if (val > 999) {
                    val = 999;
                    if (typeof showToast === 'function') {
                        showToast('Số lượng tối đa cho mỗi món là 999!', 'warning');
                    } else {
                        alert('Số lượng tối đa cho mỗi món là 999!');
                    }
                }
                updateCartQuantity(id, val, price);
            }
        });

        document.addEventListener('change', async function (e) {
            if (e.target.classList.contains('note-input')) {
                const productId = e.target.getAttribute('data-id');
                const note = e.target.value;

                try {
                    const response = await fetch('/cart/update-note', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, note })
                    });

                    const result = await response.json();
                    if (!result.success) {
                        alert(result.message || 'Lỗi cập nhật ghi chú');
                    }
                } catch (error) {
                    console.error('Lỗi khi gọi API update note:', error);
                }
            }
        });
    </script>

    <%- include('../partials/footer') %>