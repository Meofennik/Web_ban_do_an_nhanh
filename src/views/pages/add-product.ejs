<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thêm món ăn mới</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .fixed-video-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      pointer-events: none;
    }

    .fixed-video-background video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .fixed-video-background::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.4);
    }

    .add-page {
      max-width: 1080px;
      margin: 40px auto;
      padding: 32px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-top: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
      color: #fff;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #ee4d2d;
      margin: 0 0 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .page-header h1 {
      margin: 0;
      font-size: 36px;
      line-height: 1.05;
      color: #1f2937;
    }

    .back-home {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 18px;
      border-radius: 999px;
      background: rgba(238, 77, 45, 0.12);
      color: #ee4d2d;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
    }

    .page-subtitle {
      margin: 0 0 30px;
      color: #475569;
      font-size: 16px;
      line-height: 1.75;
    }

    .product-form {
      display: grid;
      gap: 24px;
    }

    .product-form-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 24px;
    }

    .card {
      background: #f8fafc;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 24px;
      padding: 28px;
    }

    .card-highlight {
      background: #fff;
      box-shadow: 0 18px 50px rgba(15, 23, 42, 0.06);
    }

    .card h2 {
      margin: 0 0 10px;
      font-size: 22px;
      color: #111827;
    }

    .section-desc,
    .field-group label,
    .section-title {
      color: #475569;
    }

    .section-desc {
      margin: 0 0 20px;
      font-size: 14px;
      line-height: 1.8;
    }

    .section-title {
      margin: 0 0 4px;
      font-size: 18px;
      font-weight: 700;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 16px;
    }

    label {
      font-size: 14px;
      font-weight: 700;
    }

    input,
    select,
    textarea {
      width: 95%;
      padding: 14px 16px;
      border-radius: 16px;
      border: 1px solid #e2e8f0;
      outline: none;
      font-size: 15px;
      background: #fff;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #ee4d2d;
      box-shadow: 0 0 0 4px rgba(238, 77, 45, 0.08);
    }

    select {
      appearance: none;
      background-image: linear-gradient(45deg, transparent 50%, #64748b 50%), linear-gradient(135deg, #64748b 50%, transparent 50%);
      background-position: calc(100% - 20px) calc(1em + 2px), calc(100% - 15px) calc(1em + 2px);
      background-size: 8px 8px, 8px 8px;
      background-repeat: no-repeat;
    }

    textarea {
      min-height: 170px;
      resize: vertical;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .card-footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.95));
      border: 1px solid rgba(226, 232, 240, 0.8);
      padding: 28px;
    }

    .submit-btn {
      border: none;
      padding: 16px 28px;
      border-radius: 999px;
      background: linear-gradient(135deg, #ff7e5f, #ee4d2d);
      color: #fff;
      font-weight: 800;
      font-size: 16px;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      min-width: 220px;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 30px rgba(238, 77, 45, 0.24);
    }

    @media (max-width: 900px) {
      .product-form-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .add-page {
        margin: 20px;
        padding: 20px;
      }

      .page-header {
        flex-direction: column;
        align-items: stretch;
      }

      .card-footer {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</head>

<body>
  <div class="fixed-video-background">
    <video src="/videos/Animation Foodeats1.mp4" autoplay muted loop playsinline></video>
  </div>
  <div class="add-page">
    <div class="page-header">
      <div>
        <p class="eyebrow">FoodEats Seller Center</p>
        <h1>Thêm sản phẩm mới</h1>
      </div>
      <a href="/" class="back-home">
        ❮ Trang chủ
      </a>
    </div>

    <p class="page-subtitle">Tạo một danh sách sản phẩm chuyên nghiệp để thu hút khách và bán nhanh hơn trên nền tảng
      thương mại điện tử.</p>

    <form action="/products/add" method="POST" enctype="multipart/form-data" class="product-form">
      <div class="product-form-grid">
        <section class="card card-highlight">
          <h2>Thông tin cơ bản</h2>
          <p class="section-desc">Điền đầy đủ tên, giá và danh mục để khách hàng dễ dàng tìm thấy sản phẩm.</p>

          <div class="field-group">
            <label for="name">Tên món ăn</label>
            <input id="name" type="text" name="name" placeholder="Phở bò đặc biệt" required>
          </div>

          <div class="field-group">
            <label for="price">Giá (VNĐ)</label>
            <input id="price" type="number" name="price" placeholder="65.000" required>
          </div>

          <div class="field-group">
            <label for="category">Danh mục</label>
            <select id="category" name="category" required>
              <option value="" disabled selected>-- Chọn danh mục món ăn --</option>
              <option value="Cơm gia đình">Cơm gia đình</option>
              <option value="Cơm văn phòng">Cơm văn phòng</option>
              <option value="Món nước">Món nước</option>
              <option value="Đồ ăn nhanh">Đồ ăn nhanh</option>
              <option value="Đồ uống">Đồ uống</option>
              <option value="Ăn vặt & Tráng miệng">Ăn vặt & Tráng miệng</option>
              <option value="Đồ chay & Healthy">Đồ chay & Healthy</option>
              <option value="Ăn đêm">Ăn đêm</option>
              <option value="Combo Tiết kiệm">Combo Tiết kiệm</option>
              <option value="Thuốc & Tiện lợi">Thuốc & Tiện lợi</option>
            </select>
          </div>
        </section>

        <section class="card card-highlight">
          <h2>Media & mô tả</h2>
          <p class="section-desc">Tải lên hình ảnh chất lượng cao và mô tả hấp dẫn để tăng khả năng chuyển đổi.</p>

          <div class="field-group">
            <label for="productImage">Hình ảnh sản phẩm</label>
            <input id="productImage" type="file" name="productImage" accept="image/*" required onchange="previewImage(this, 'img-preview-add')">
            <div id="preview-wrapper-add" style="margin-top: 10px; display: none;">
              <img id="img-preview-add" src="" alt="Preview" style="width: 120px; height: 120px; object-fit: cover; border-radius: 12px; border: 2px solid #ee4d2d; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
            </div>
          </div>

          <div class="field-group full-width">
            <label for="description">Mô tả sản phẩm</label>
            <textarea id="description" name="description" rows="6"
              placeholder="Mô tả sơ bộ về hương vị, thành phần và điểm đặc biệt của món..."></textarea>
          </div>
        </section>
      </div>

      <section class="card card-footer">
        <div>
          <p class="section-title">Sẵn sàng đăng bán?</p>
          <p class="section-desc">Kiểm tra lại thông tin và nhấn nút để đưa sản phẩm lên cửa hàng của bạn.</p>
        </div>
        <button type="submit" class="submit-btn">Đăng sản phẩm</button>
      </section>
    </form>
  </div>

  <script>
    function previewImage(input, targetImgId) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.getElementById(targetImgId);
          if (img) {
            img.src = e.target.result;
            document.getElementById('preview-wrapper-add').style.display = 'block';
          }
        }
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>
</body>

</html>