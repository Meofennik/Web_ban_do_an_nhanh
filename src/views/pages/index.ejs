<%- include('../partials/header', { showFullHeader: true }) %>
  <style>
    .flying-img {
      position: fixed;
      z-index: 99999;
      border-radius: 50%;
      object-fit: cover;
      pointer-events: none;
      box-shadow: 0 8px 20px rgba(238, 77, 45, 0.4);
      transition: all 0.75s cubic-bezier(0.18, 0.89, 0.32, 1.28);
    }

    .cart-bump {
      animation: bump 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes bump {
      0% { transform: scale(1); }
      35% { transform: scale(1.45) rotate(-10deg); }
      65% { transform: scale(0.9) rotate(6deg); }
      100% { transform: scale(1) rotate(0deg); }
    }
  </style>

  <div class="fixed-video-background">
    <video id="bg-video" src="/videos/Animation Foodeats1.mp4" muted playsinline preload="auto"></video>
  </div>

  <main class="main-content transparent-content">
    <div class="scroll-ambient" aria-hidden="true">
      <span class="ambient-orb orb-1"></span>
      <span class="ambient-orb orb-2"></span>
      <span class="ambient-orb orb-3"></span>
      <span class="ambient-wave wave-1"></span>
      <span class="ambient-wave wave-2"></span>
    </div>

    <section class="hero-3d-section reveal-item">
      <div class="hero-text">
        <span class="tag">🔥 Ưu đãi cực hot hôm nay</span>
        <h1>Đặt Đồ Ăn Ngon <br>Giao Hàng Trong 20 Phút</h1>
        <p>Hàng ngàn món ngon từ các thương hiệu yêu thích đang giảm giá đến 50%.</p>
        <button class="btn-cta" onclick="filterCategory('cat-sec-0', document.querySelector('.cat-pill:nth-child(2)'))">Khám phá ngay</button>
      </div>

      <div class="hero-3d-card" data-tilt data-tilt-max="15">
        <div class="card-background"></div>
        <img src="/images/indexPhoto/do_an_nhanh.png" alt="Đồ ăn nhanh">
        <div class="card-badge">Giảm 50%</div>
      </div>
    </section>

    <section class="menu-section">
      <div class="transparent-container">

        <% if (categoriesData && Object.keys(categoriesData).length) { %>
          <% const categoryKeys=Object.keys(categoriesData); %>
          
          <!-- Category Quick Filter Pills -->
          <div class="category-pills-bar reveal-item" style="display: flex; gap: 10px; overflow-x: auto; padding-bottom: 15px; margin-bottom: 25px; scrollbar-width: none;">
            <button type="button" class="cat-pill active" onclick="filterCategory('all', this)" style="padding: 9px 20px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.3); background: #ee4d2d; color: white; font-weight: bold; font-size: 13.5px; cursor: pointer; white-space: nowrap; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
              🍽️ Tất cả
            </button>
            <% categoryKeys.forEach((catName, idx) => { %>
              <button type="button" class="cat-pill" onclick="filterCategory('cat-sec-<%= idx %>', this)" style="padding: 9px 20px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.15); color: white; font-weight: 600; font-size: 13.5px; cursor: pointer; white-space: nowrap; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
                <%= catName %>
              </button>
            <% }) %>
          </div>

            <% for (let index=0; index < categoryKeys.length; index++) { %>
              <% const categoryName=categoryKeys[index]; %>
                <div class="category-wrapper reveal-item" id="cat-sec-<%= index %>">
                  <h3 class="category-title" style="display: flex; align-items: center; justify-content: space-between;">
                    <span><%= categoryName %></span>
                    <span style="font-size: 13px; font-weight: normal; color: rgba(255,255,255,0.7);">
                      <%= (categoriesData[categoryName] || []).length %> món ngon
                    </span>
                  </h3>

                  <div class="carousel-container" style="position: relative;">

                    <button type="button" class="slide-btn left-btn" onclick="scrollCarousel(this, -1)" aria-label="Cuộn trái">&#10094;</button>

                    <div class="food-carousel">
                      <% const products=Array.isArray(categoriesData[categoryName]) ? categoriesData[categoryName] : []; %>
                      <% for (let p=0; p < products.length; p++) { %>
                        <% const product=products[p]; %>
                          <div class="food-item" style="position: relative;">
                            <a href="/products/<%= product._id %>"
                              style="text-decoration: none; color: inherit; display: block;">
                              <div style="position: relative; overflow: hidden; border-radius: 8px;">
                                <img
                                  src="<%= product && product.imageUrl ? product.imageUrl : '/images/placeholder.png' %>"
                                  alt="<%= product && product.name ? product.name : 'Sản phẩm' %>">
                                <span style="position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.65); color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 4px; font-weight: bold;">
                                  ⚡ 15-20p
                                </span>
                              </div>
                              <h4 style="margin-top: 8px;">
                                <%= product && product.name ? product.name : 'Không tên' %>
                              </h4>
                              <span class="address">
                                <%= product.storeAddress %>
                              </span>
                            </a>

                            <div class="food-bottom">
                              <p>
                                <%= (Number(product && product.price) || 0).toLocaleString('vi-VN') %>đ
                              </p>

                              <button class="btn-add-cart" data-id="<%= product._id %>" title="Thêm vào giỏ">+</button>
                            </div>
                          </div>
                      <% } %>
                    </div>

                    <button type="button" class="slide-btn right-btn" onclick="scrollCarousel(this, 1)" aria-label="Cuộn phải">&#10095;</button>

                  </div>

                </div>
            <% } %>
        <% } else { %>
          <p class="empty-state">Chưa có dữ liệu món ăn để hiển thị.</p>
        <% } %>
      </div>
    </section>
  </main>

  <script>
    // Custom cinematic smooth scroll with requestAnimationFrame and easeInOutCubic
    function smoothScrollToTarget(targetY, duration = 950) {
      const startY = window.pageYOffset || document.documentElement.scrollTop;
      const distance = targetY - startY;
      let startTime = null;

      // Easing function: gentle acceleration, graceful slow deceleration
      function easeInOutCubic(t) {
        return t < 0.5 
          ? 4 * t * t * t 
          : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function scrollStep(currentTime) {
        if (!startTime) startTime = currentTime;
        const timeElapsed = currentTime - startTime;
        const progress = Math.min(timeElapsed / duration, 1);
        const ease = easeInOutCubic(progress);

        window.scrollTo(0, startY + (distance * ease));

        if (progress < 1) {
          window.requestAnimationFrame(scrollStep);
        }
      }

      window.requestAnimationFrame(scrollStep);
    }

    // Smooth navigation directly to category title
    function filterCategory(targetId, btnElement) {
      if (btnElement) {
        document.querySelectorAll('.cat-pill').forEach(pill => {
          pill.style.background = 'rgba(255,255,255,0.15)';
          pill.style.boxShadow = 'none';
        });
        btnElement.style.background = '#ee4d2d';
        btnElement.style.boxShadow = '0 4px 14px rgba(238, 77, 45, 0.4)';
      }

      if (targetId === 'all') {
        const menuSec = document.querySelector('.menu-section');
        if (menuSec) {
          const navbar = document.querySelector('.navbar');
          const navHeight = navbar ? navbar.offsetHeight : 80;
          const targetTop = Math.max(0, menuSec.getBoundingClientRect().top + window.pageYOffset - navHeight - 15);
          smoothScrollToTarget(targetTop, 900);
        }
      } else {
        const el = document.getElementById(targetId);
        if (el) {
          // Pre-reveal to calculate accurate height
          el.classList.add('is-revealed');
          
          const navbar = document.querySelector('.navbar');
          const navHeight = navbar ? navbar.offsetHeight : 80;
          const targetTop = Math.max(0, el.getBoundingClientRect().top + window.pageYOffset - navHeight - 25);

          smoothScrollToTarget(targetTop, 950);

          // Soft highlight on title
          const title = el.querySelector('.category-title');
          if (title) {
            title.style.transition = 'transform 0.6s cubic-bezier(0.19, 1, 0.22, 1), color 0.6s ease';
            title.style.color = '#ffeaa7';
            title.style.transform = 'translateX(10px)';
            setTimeout(() => {
              title.style.color = '#fff';
              title.style.transform = 'translateX(0)';
            }, 1600);
          }
        }
      }
    }

    // Dynamic carousel arrow visibility check (only show when content overflows)
    function updateCarouselArrows(container) {
      const carousel = container.querySelector('.food-carousel');
      const leftBtn = container.querySelector('.left-btn');
      const rightBtn = container.querySelector('.right-btn');
      if (!carousel || !leftBtn || !rightBtn) return;

      const maxScrollLeft = carousel.scrollWidth - carousel.clientWidth;

      // If all items fit within container, hide both buttons
      if (maxScrollLeft <= 5) {
        leftBtn.classList.remove('visible');
        rightBtn.classList.remove('visible');
        return;
      }

      // Left arrow: only show if scrolled away from the start
      if (carousel.scrollLeft > 15) {
        leftBtn.classList.add('visible');
      } else {
        leftBtn.classList.remove('visible');
      }

      // Right arrow: only show if there is more content to scroll to
      if (carousel.scrollLeft < maxScrollLeft - 15) {
        rightBtn.classList.add('visible');
      } else {
        rightBtn.classList.remove('visible');
      }
    }

    function scrollCarousel(btn, direction) {
      const container = btn.closest('.carousel-container');
      const carousel = container ? container.querySelector('.food-carousel') : null;
      if (carousel) {
        const scrollAmount = (carousel.clientWidth * 0.75) * direction;
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        setTimeout(() => updateCarouselArrows(container), 350);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {

      // Initialize Carousel Arrow listeners and states
      document.querySelectorAll('.carousel-container').forEach(container => {
        const carousel = container.querySelector('.food-carousel');
        if (carousel) {
          carousel.addEventListener('scroll', () => {
            updateCarouselArrows(container);
          }, { passive: true });

          updateCarouselArrows(container);
        }
      });

      window.addEventListener('resize', () => {
        document.querySelectorAll('.carousel-container').forEach(container => {
          updateCarouselArrows(container);
        });
      }, { passive: true });

      // Apple/Tech-style Scroll Reveal with IntersectionObserver
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
          }
        });
      }, {
        root: null,
        rootMargin: '0px 0px -40px 0px',
        threshold: 0.1
      });

      document.querySelectorAll('.reveal-item, .category-wrapper').forEach(el => {
        revealObserver.observe(el);
      });

      // Fly to cart animation
      function flyToCart(buttonElement) {
        const cartIcon = document.getElementById('cart-icon');
        if (!cartIcon) return;

        const foodItem = buttonElement.closest('.food-item'); 
        const productImg = foodItem ? foodItem.querySelector('img') : null;
        if (!productImg) return;

        const startRect = productImg.getBoundingClientRect();
        const endRect = cartIcon.getBoundingClientRect();

        const flyingImg = productImg.cloneNode();
        flyingImg.classList.add('flying-img');

        flyingImg.style.left = `${startRect.left}px`;
        flyingImg.style.top = `${startRect.top}px`;
        flyingImg.style.width = `${startRect.width}px`;
        flyingImg.style.height = `${startRect.height}px`;

        document.body.appendChild(flyingImg);

        void flyingImg.offsetWidth;

        flyingImg.style.left = `${endRect.left + (endRect.width / 2) - 20}px`;
        flyingImg.style.top = `${endRect.top + (endRect.height / 2) - 20}px`;
        flyingImg.style.width = '40px';
        flyingImg.style.height = '40px';
        flyingImg.style.opacity = '0.4';

        setTimeout(() => {
          flyingImg.remove(); 

          cartIcon.classList.add('cart-bump');
          setTimeout(() => cartIcon.classList.remove('cart-bump'), 450);
        }, 750);
      }

      document.addEventListener('click', async (e) => {
        if (e.target && e.target.classList.contains('btn-add-cart')) {
          e.preventDefault();
          e.stopPropagation();

          const btn = e.target;
          const productId = btn.getAttribute('data-id');

          try {
            const response = await fetch('/cart/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId, quantity: 1 })
            });

            const result = await response.json();

            if (response.ok && result.success) {
              flyToCart(btn);

              const cartBadge = document.getElementById('cart-badge');
              if (cartBadge) {
                cartBadge.innerText = result.totalItems;
                cartBadge.style.display = 'inline-block';
              }
              if (typeof showToast === 'function') {
                showToast('Đã thêm món vào giỏ hàng!', 'success');
              }
            } else {
              if (typeof showToast === 'function') {
                showToast(result.message || 'Chưa thể thêm món!', 'error');
              }
              if (response.status === 401) {
                setTimeout(() => {
                  window.location.href = '/login';
                }, 1500);
              }
            }
          }
          catch (err) {
            console.error(err);
          }
        }
      });

    });
  </script>
  <%- include('../partials/footer') %>