<%- include('../partials/header') %>
  <style>
    .flying-img {
      position: fixed;
      z-index: 99999;
      border-radius: 50%;
      object-fit: cover;
      pointer-events: none;
      transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .cart-bump {
      animation: bump 0.3s ease-out;
    }

    @keyframes bump {
      0% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.3);
      }

      100% {
        transform: scale(1);
      }
    }
  </style>

  <div class="fixed-video-background">
    <video id="bg-video" src="/videos/Animation Foodeats1.mp4" muted playsinline preload="auto"></video>
  </div>

  <main class="main-content transparent-content">
    <div class="scroll-ambient" aria-hidden="true">
      <span class="ambient-orb orb-1"></span>
      <span class="ambient-orb orb-2"></span>
      <span class="ambient-orb orb-3"></span>
      <span class="ambient-wave wave-1"></span>
      <span class="ambient-wave wave-2"></span>
    </div>

    <section class="hero-3d-section">
      <div class="hero-text">
        <span class="tag">🔥 Ưu đãi cực hot hôm nay</span>
        <h1>Đặt Đồ Ăn Ngon <br>Giao Hàng Trong 20 Phút</h1>
        <p>Hàng ngàn món ngon từ các thương hiệu yêu thích đang giảm giá đến 50%.</p>
        <button class="btn-cta">Khám phá ngay</button>
      </div>

      <div class="hero-3d-card" data-tilt data-tilt-max="15">
        <div class="card-background"></div>
        <img src="/images/indexPhoto/do_an_nhanh.png" alt="Đồ ăn nhanh">
        <div class="card-badge">Giảm 50%</div>
      </div>
    </section>

    <section class="menu-section">
      <div class="transparent-container">

        <% if (categoriesData && Object.keys(categoriesData).length) { %>
          <% const categoryKeys=Object.keys(categoriesData); %>
            <% for (let index=0; index < categoryKeys.length; index++) { %>
              <% const categoryName=categoryKeys[index]; %>
                <div class="category-wrapper">
                  <h3 class="category-title">
                    <%= categoryName %>
                  </h3>

                  <div class="carousel-container" style="position: relative;">

                    <button class="slide-btn left-btn" style="display: none;">&#10094;</button>

                    <div class="food-carousel">
                      <% const products=Array.isArray(categoriesData[categoryName]) ? categoriesData[categoryName] : [];
                        %>
                        <% for (let p=0; p < products.length; p++) { %>
                          <% const product=products[p]; %>
                            <div class="food-item">
                              <a href="/products/<%= product._id %>"
                                style="text-decoration: none; color: inherit; display: block;">
                                <img
                                  src="<%= product && product.imageUrl ? product.imageUrl : '/images/placeholder.png' %>"
                                  alt="<%= product && product.name ? product.name : 'Sản phẩm' %>">
                                <h4>
                                  <%= product && product.name ? product.name : 'Không tên' %>
                                </h4>
                                <span class="address">
                                  <%= product.storeAddress %>
                                </span>
                              </a>

                              <div class="food-bottom">
                                <p>
                                  <%= (Number(product && product.price) || 0).toLocaleString('vi-VN') %>đ
                                </p>

                                <button class="btn-add-cart" data-id="<%= product._id %>">+</button>
                              </div>
                            </div>
                            <% } %>
                    </div>

                    <button class="slide-btn right-btn">&#10095;</button>

                  </div>

                </div>
                <% } %>
                  <% } else { %>
                    <p class="empty-state">Chưa có dữ liệu món ăn để hiển thị.</p>
                    <% } %>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {

      function flyToCart(buttonElement) {
        const cartIcon = document.getElementById('cart-icon');
        if (!cartIcon) return;

        const foodItem = buttonElement.closest('.food-item'); 
        const productImg = foodItem ? foodItem.querySelector('img') : null;
        if (!productImg) return;

        const startRect = productImg.getBoundingClientRect();
        const endRect = cartIcon.getBoundingClientRect();

        const flyingImg = productImg.cloneNode();
        flyingImg.classList.add('flying-img');

        flyingImg.style.left = `${startRect.left}px`;
        flyingImg.style.top = `${startRect.top}px`;
        flyingImg.style.width = `${startRect.width}px`;
        flyingImg.style.height = `${startRect.height}px`;

        document.body.appendChild(flyingImg);

        void flyingImg.offsetWidth;

        flyingImg.style.left = `${endRect.left + (endRect.width / 2) - 20}px`;
        flyingImg.style.top = `${endRect.top + (endRect.height / 2) - 20}px`;
        flyingImg.style.width = '40px';
        flyingImg.style.height = '40px';
        flyingImg.style.opacity = '0.4';

        setTimeout(() => {
          flyingImg.remove(); 

          cartIcon.classList.add('cart-bump');
          setTimeout(() => cartIcon.classList.remove('cart-bump'), 300);
        }, 800);
      }


      document.addEventListener('click', async (e) => {
        if (e.target && e.target.classList.contains('btn-add-cart')) {
          e.preventDefault();
          e.stopPropagation();

          const btn = e.target;
          const productId = btn.getAttribute('data-id');

          try {
            const response = await fetch('/cart/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId, quantity: 1 })
            });

            const result = await response.json();

            if (response.ok && result.success) {

              flyToCart(btn);

              const cartBadge = document.getElementById('cart-badge');
              if (cartBadge) {
                cartBadge.innerText = result.totalItems;
                cartBadge.style.display = 'inline-block';
              }
            } else {
              showToast(result.message || 'Chưa thể thêm món!', 'error')
              if (response.status === 401) {
                setTimeout(() => {
                  window.location.href = '/login';
                }, 1500);
              }
            }
          }
          catch (err) {
            console.error(err);
          }
        }
      });

    });
  </script>
  <%- include('../partials/footer') %>