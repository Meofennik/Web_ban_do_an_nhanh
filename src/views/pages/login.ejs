<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Đăng nhập - FoodEats</title>
  <link rel="stylesheet" href="/css/auth.css">
</head>
<style>.custom-icon {
  width: 20px;      
  height: 20px;   
  object-fit: contain; 
  vertical-align: middle; 
  margin-right: 5px; 
}

.custom-icon-lg {
  width: 24px;
  height: 24px;
  vertical-align: middle;
  margin-right: 8px;
}</style>
<body>

  <div class="fixed-video-background">
    <video src="/videos/Animation Foodeats1.mp4" autoplay muted loop playsinline></video>
  </div>
  <a href="/" class="btn-back-home">
    ❮ Trang chủ
  </a>
  <div id="toast" class="toast"></div>

  <div class="auth-wrapper">
    <div class="auth-box">
      <div class="auth-header">
        <a href="/" class="auth-logo">Food<span>Eats</span></a>
        <h2 class="auth-title">Chào mừng trở lại!</h2>
        <p class="auth-subtitle">Đăng nhập để tiếp tục đặt món ngon và tận hưởng ưu đãi</p>
      </div>

      <form id="loginForm" action="/login" method="POST" onsubmit="handleLogin(event)">
        
        <div class="form-group">
          <label>Số điện thoại</label>
          <div class="input-group">
            <input type="tel" name="phone" id="loginPhone" pattern="^(0|\+84)[3|5|7|8|9][0-9]{8}$" placeholder="Ví dụ: 0912345678" required>
            <button type="button" class="btn-otp" onclick="sendOTP()">Gửi OTP</button>
          </div>
        </div>

        <div class="form-group">
          <label>Mã OTP (Nếu đăng nhập không dùng mật khẩu)</label>
          <input type="text" name="otp" placeholder="Nhập 6 số OTP" maxlength="6">
        </div>

        <div class="form-group">
          <label>Mật khẩu</label>
          <div class="password-wrapper">
            <input type="password" id="loginPassword" name="password" placeholder="Nhập mật khẩu của bạn">
            <button type="button" class="eye-btn" onclick="togglePassword('loginPassword', this)"><img src="/images/iconsImages/view.png" alt="view" class="custom-icon-lg"></button>
          </div>
        </div>

        <div class="forgot-link-wrapper">
          <a href="/forgot-password" class="forgot-link">Bạn đã quên mật khẩu?</a>
        </div>

        <div class="action-buttons">
          <button type="submit" class="btn-submit">Đăng nhập</button>

          <div class="social-auth-divider">
            <span>Hoặc đăng nhập với</span>
          </div>

          <div class="social-buttons">
            <button type="button" class="btn-social" onclick="showToast('Đăng nhập bằng Google đang được xử lý...', 'success')">
              <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
                <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12 0 14.5s.7 4.8 1.9 7.2l3.7-2.9z"/>
                <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.4-6.4-5.2L1.9 17C3.7 20.7 7.5 24 12 24z"/>
              </svg>
              <span>Google</span>
            </button>
            <button type="button" class="btn-social" onclick="showToast('Đăng nhập bằng Facebook đang được xử lý...', 'success')">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook</span>
            </button>
          </div>

          <a href="/register" class="btn-secondary">Chưa có tài khoản? Đăng ký ngay</a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/auth.js"></script>
</body>
</html>