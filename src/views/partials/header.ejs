<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FoodEats - Đặt Đồ Ăn Ngon Tận Nơi</title>
  <!-- Gọi file CSS chung cho mọi trang -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Nếu Route có truyền biến customCss, thì mới tải thêm file CSS riêng của trang đó -->
  <% if (typeof customCss !== 'undefined') { %>
    <link rel="stylesheet" href="<%= customCss %>">
  <% } %>
  <!-- Thư viện hỗ trợ hiệu ứng nghiêng 3D -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
</head>
<body>

  <header class="navbar">
    <div class="nav-container">
      <div class="nav-top">
        <a href="/" class="logo">Food<span>Eats</span></a>

        <div class="search-box">
          <input id="global-search" type="text" placeholder="Tìm món ăn, quán ăn, trà sữa...">
          <button class="btn-search">Tìm kiếm</button>
        </div>

        <!-- KHU VỰC CÁC NÚT BÊN PHẢI HEADER -->
        <div class="header-actions">
  
  <!-- Nếu đã đăng nhập -->
  <% if (user) { %>
    
    <!-- CHỈ CÓ CỬA HÀNG (seller) MỚI THẤY NÚT NÀY -->
    <% if (user.role === 'seller') { %>
      <a href="/add-product" class="btn-add-product">➕ Thêm món ăn</a>
    <% } %>

    <!-- Nút Giỏ hàng (Ai cũng thấy nếu cần) -->
    <a href="/cart" class="btn-cart">🛒 3</a>

    <!-- Menu Thông tin người dùng -->
    <div class="user-dropdown">
      <button class="btn-user-profile">👋 Xin chào, <%= user.name %></button>
      <div class="dropdown-content">
        <div class="user-info-box">
          <p><strong><%= user.name %></strong></p>
          <p class="role-badge"><%= user.role === 'seller' ? 'Cửa hàng' : 'Thành viên' %></p>
        </div>
        <hr>
        <a href="/profile">Hồ sơ cá nhân</a>
        <% if (user.role === 'seller') { %>
          <a href="/products/manage">📦 Quản lý sản phẩm</a>
          <a href="/orders/manage">📋 Quản lý đơn đặt hàng</a>
        <% } else { %>
          <a href="/orders">🛒 Đơn hàng của tôi</a>
        <% } %>
        <a href="/logout" class="text-danger">Đăng xuất</a>
      </div>
    </div>

  <!-- Nếu chưa đăng nhập -->
  <% } else { %>
    <a href="/login" class="btn-login">Đăng nhập</a>
  <% } %>

</div>

          <div class="nav-bottom">
            <div class="nav-location">
              <a href="/location" class="location-display">
                📍 <span id="navbar-address">Giao đến: Nhấn để chọn địa điểm</span>
              </a>
            </div>
          </div>
    </div>
  </header>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const addressEl = document.getElementById('navbar-address');
      if (!addressEl) return;
      const savedAddress = localStorage.getItem('userAddress');
      if (savedAddress) {
        addressEl.textContent = `Giao đến: ${savedAddress}`;
      }
    });
  </script>