<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FoodEats - Đặt Đồ Ăn Ngon Tận Nơi</title>
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof customCss !== 'undefined') { %>
    <link rel="stylesheet" href="<%= customCss %>">
  <% } %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
</head>

<style>
  .custom-icon {
  width: 20px;      
  height: 20px;   
  object-fit: contain; 
  vertical-align: middle; 
  margin-right: 5px; 
}

.custom-icon-lg {
  width: 24px;
  height: 24px;
  vertical-align: middle;
  margin-right: 8px;
}
</style>
<body>

  <header class="navbar">
    <div class="nav-container">
      
      <div class="nav-top">
        <a href="/" class="logo">Food<span>Eats</span></a>

        <div class="search-box">
          <input id="global-search" type="text" placeholder="Tìm món ăn, quán ăn, trà sữa...">
          <button class="btn-search"><img src="/images/iconsImages/search-interface-symbol.png" alt="search-interface-symbol" class="custom-icon-lg"></button>
        </div>

        <div class="header-actions">
  
          <% if (user) { %>
            
            <% if (user.role === 'seller') { %>
              <a href="/add-product" class="btn-add-product">➕ Thêm món ăn</a>
            <% } %>

            <a href="/cart" id="cart-icon" style="position: relative; text-decoration: none; color: #333; font-weight: bold; margin-right: 20px;">
              🛒 
              <span id="cart-badge" style="
                position: absolute; 
                top: -10px; 
                right: -20px; 
                background: #ee4d2d; 
                color: white; 
                border-radius: 50%; 
                padding: 2px 7px; 
                font-size: 12px; 
                font-weight: bold;
                border: 2px solid white;
                display: <%= cartItemCount > 0 ? 'inline-block' : 'none' %>;">
                <%= cartItemCount %>
              </span>
            </a>

            <div class="user-dropdown">
              <button class="btn-user-profile">👋 Xin chào, <%= user.fullName || user.name %></button>
              <div class="dropdown-content">
                <div class="user-info-box">
                  <p><strong><%= user.fullName || user.name %></strong></p>
                  <p class="role-badge"><%= user.role === 'seller' ? 'Cửa hàng' : 'Thành viên' %></p>
                </div>
                <hr>
                <a href="/profile">Hồ sơ cá nhân</a>
                <% if (user.role === 'seller') { %>
                  <a href="/products/manage">Quản lý sản phẩm</a>
                  <a href="/order/store-orders" class="dropdown-item">Quản lý đơn đặt hàng</a>
                <% } else { %>
                  <a href="/cart">🛒 Đơn hàng của tôi</a>
                <% } %>
                <a href="/logout" class="text-danger">Đăng xuất</a>
              </div>
            </div>

          <% } else { %>
            <a href="/login" class="btn-login">Đăng nhập</a>
          <% } %>

        </div>
      </div> 

      <div class="nav-bottom">
        <div class="nav-location">
          <a href="/location" class="location-display">
            <img src="/images/iconsImages/placeholder.png" alt="placeholder" class="custom-icon-lg"> <span id="navbar-address">Giao đến: Nhấn để chọn địa điểm</span>
          </a>
        </div>
      </div>

    </div> 
  </header>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const addressEl = document.getElementById('navbar-address');
      if (!addressEl) return;
      const savedAddress = localStorage.getItem('userAddress');
      if (savedAddress) {
        addressEl.textContent = `Giao đến: ${savedAddress}`;
      }
    });
  </script>